# AngelOne SmartAPI — MARKET DATA ONLY.
# Argona never places orders; these credentials are used for the option chain,
# quotes and historical candles. Copy to `.env` and fill in. `.env` is gitignored.

# From the SmartAPI dashboard (My Smart API & Apps)
ANGELONE_API_KEY=

# Your AngelOne login / client code (e.g. A123456)
ANGELONE_CLIENT_CODE=

# Your AngelOne MPIN (the 4-digit PIN, not the web password)
ANGELONE_PIN=

# TOTP secret from SmartAPI "Enable TOTP" — the base32 STRING shown when you
# set up 2FA (not the 6-digit code, which rotates). Looks like: JBSWY3DPEHPK3PXP
ANGELONE_TOTP_SECRET=

# NOTE: SmartAPI restricts API calls to the Static IP registered on your app.
# Your app "claude" lists 106.219.122.27 — if this machine's public IP differs,
# calls will be rejected and you'll need to update it in the dashboard
# (editable once per week).
